NODE_ENV=production
HOST=127.0.0.1
PORT=3015
# Use the WRITE endpoint of MySQL Router for this transactional service.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sfc_cmr
DB_USER=sfc_cmr_app
DB_PASSWORD=replace_with_a_unique_password
# Only needed for Docker Compose; leave empty for an existing MySQL installation.
MYSQL_ROOT_PASSWORD=
DB_POOL_LIMIT=10
DB_SSL_CA_FILE=
TRUST_PROXY_HOPS=0
ACCESS_TOKEN_MINUTES=15
REFRESH_SESSION_DAYS=7
# Exact browser origins, comma separated. Never use * with cookies.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# For local HTTP use false; use true behind production HTTPS.
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
# Optional core DM access, including Miller registration and setup options.
CORE_DM_ENABLED=false
CORE_JWT_ACCESS_SECRET=
CORE_DB_HOST=
CORE_DB_PORT=3306
CORE_DB_NAME=
CORE_DB_USER=
CORE_DB_PASSWORD=
CORE_DB_SSL_CA_FILE=
ENABLE_CMR_TEST_SETUP=false
# One-off bootstrap; remove from .env after admin creation.
ADMIN_EMAIL=admin@example.org
ADMIN_NAME=SFC Administrator
ADMIN_PASSWORD=replace_with_a_unique_16_character_password
# Separate inbound integration and GPS credentials. Generate: openssl rand -hex 32
EUPARJAN_API_KEY=replace_with_random_key_at_least_32_characters
GPS_API_KEY=replace_with_another_random_key_at_least_32_characters
GPS_MAX_FUTURE_SECONDS=120
GPS_STALE_MINUTES=15
# Optional normalized MQTT adapter; run one worker, separate from HTTP.
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=sfc-cmr-gps-worker
MQTT_TOPIC=gps/+/data
MQTT_CA_FILE=
